{
  "name": "luigi-ui",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "build": "pnpm colors:check && tsx scripts/build.ts",
    "storybook": "pnpm colors:check && storybook dev -p 6006 --no-open",
    "build-storybook": "pnpm colors:check && storybook build --disable-telemetry",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm colors:check && pnpm lint && pnpm format:check && pnpm typecheck && pnpm build && pnpm test",
    "test": "tsx --test scripts/*.test.ts",
    "lint": "eslint --config eslint.config.ts . --max-warnings=0",
    "prepack": "pnpm build",
    "colors:generate": "tsx scripts/generate-colors.ts",
    "colors:check": "tsx scripts/generate-colors.ts --check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/react-vite": "10.6.3",
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-x": "5.23.5",
    "globals": "^16.5.0",
    "jiti": "2.7.0",
    "prettier": "^3.6.0",
    "react": "^19.0.0",
    "react-dom": "19.3.1",
    "storybook": "10.6.3",
    "storybook-addon-pseudo-states": "10.6.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.5"
  },
  "description": "React 应用组件库，提供语义主题与独立 CSS",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./dist/theme.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.62.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^4.0.1"
  }
}
