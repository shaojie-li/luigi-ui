{
  "name": "luigi-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "build": "tsx scripts/build-registry.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && tsx scripts/build-registry.ts --check && pnpm test",
    "test": "tsx --test scripts/*.test.ts",
    "lint": "eslint --config eslint.config.ts . --max-warnings=0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.6.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "yaml": "^2.8.0",
    "zod": "4.6.5",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "@base-ui/react": "^1.8.0",
    "@tanstack/react-table": "^8.21.3",
    "eslint": "10.12.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.71.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-x": "5.23.5",
    "globals": "^16.5.0",
    "jiti": "2.7.0"
  }
}
