{
  "name": "luigi-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "build": "tsx scripts/build-registry.ts",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build --disable-telemetry",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && tsx scripts/build-registry.ts --check && pnpm test",
    "test": "tsx --test scripts/*.test.ts",
    "lint": "eslint --config eslint.config.ts . --max-warnings=0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@eslint/js": "10.0.1",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/react-vite": "10.6.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "clsx": "^2.1.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-x": "5.23.5",
    "globals": "^16.5.0",
    "jiti": "2.7.0",
    "lucide-react": "^1.62.0",
    "prettier": "^3.6.0",
    "react": "^19.0.0",
    "react-dom": "19.3.1",
    "storybook": "10.6.3",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.5",
    "yaml": "^2.8.0",
    "zod": "4.6.5"
  }
}
